{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["tests/**/*.ts", "pages/**/*.ts", "helpers/**/*.ts", "test-data/**/*.ts"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
